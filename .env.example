# Local development defaults. Copy to .env; never commit the copy.
PROJECT_NAME=CityMind Tripoli
CITY_NAME=Tripoli
COUNTRY_NAME=Lebanon
APP_ENV=local
LOG_LEVEL=INFO
LOG_FORMAT=text

API_PORT=8100
WEB_PORT=3100
NEXT_PUBLIC_API_URL=http://127.0.0.1:8100

DATABASE_URL=postgresql+psycopg://citymind:citymind@localhost:5432/citymind
DATABASE_READINESS_REQUIRED=false
OPERATIONAL_PERSISTENCE_BACKEND=memory
SCENARIO_PERSISTENCE_BACKEND=memory
SCENARIO_HISTORY_LIMIT=100
POSTGRES_DB=citymind
POSTGRES_USER=citymind
POSTGRES_PASSWORD=citymind

AUTH_TOKEN_SECRET=citymind-local-development-secret-change-before-production
AUTH_TOKEN_TTL_SECONDS=3600
AUTH_TOKEN_REFRESH_THRESHOLD_SECONDS=900
PASSWORD_MIN_LENGTH=10
LOGIN_MAX_ATTEMPTS=5
LOGIN_IP_MAX_ATTEMPTS=30
LOGIN_WINDOW_SECONDS=60
LOGIN_RATE_LIMIT_MAX_KEYS=10000
RATE_LIMIT_BACKEND=memory
REGISTER_MAX_ATTEMPTS=5
REPORT_CREATE_MAX_ATTEMPTS=20
ASSISTANT_QUERY_MAX_ATTEMPTS=30
PUBLIC_READ_MAX_ATTEMPTS=120
PUBLIC_QUERY_WINDOW_SECONDS=60
MAX_REQUEST_BODY_BYTES=256000
DOCS_ENABLED=true
CORS_ORIGINS=["http://127.0.0.1:3100","http://localhost:3000"]
TRUSTED_HOSTS=["127.0.0.1","localhost","testserver"]

# Demo accounts use the passwords published in README.md. Local development only;
# the API refuses to start in production when this is true.
ALLOW_DEMO_USERS=true
# Account email. "console" prints verification and reset links in the API log so
# the flows can be tried locally; production requires EMAIL_BACKEND=smtp.
PUBLIC_WEB_URL=http://127.0.0.1:3100
EMAIL_BACKEND=console
# Unset locally means verification is optional; production always requires it.
# EMAIL_VERIFICATION_REQUIRED=true
SENTRY_DSN=

# Optional: create one real owner account when the database is first seeded.
BOOTSTRAP_OWNER_EMAIL=
BOOTSTRAP_OWNER_PASSWORD=

# AI assistant provider: local_rag (no key, default) | gemini | openai
AI_PROVIDER=local_rag
AI_ALLOW_LOCAL_FALLBACK=true
RAG_TOP_K=4
RAG_MIN_SCORE=0.34

# Google Gemini (Google AI Studio key). Server-side only: never prefix with NEXT_PUBLIC_.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=30
GEMINI_MAX_OUTPUT_TOKENS=2048
GEMINI_TEMPERATURE=0.2

# OpenAI. Server-side only.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_REASONING_EFFORT=low
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_OUTPUT_TOKENS=2048

REDIS_URL=redis://localhost:6379/0
MINIO_ROOT_USER=citymind
MINIO_ROOT_PASSWORD=citymind-local-password
STORAGE_PROVIDER=local
