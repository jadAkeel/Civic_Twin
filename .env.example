PROJECT_NAME=CityMind Tripoli
CITY_NAME=Tripoli
COUNTRY_NAME=Lebanon
APP_ENV=local
LOG_LEVEL=INFO

API_PORT=8100
WEB_PORT=3100
NEXT_PUBLIC_API_URL=http://127.0.0.1:8100

DATABASE_URL=postgresql+psycopg://citymind:citymind@localhost:5432/citymind
DATABASE_READINESS_REQUIRED=false
OPERATIONAL_PERSISTENCE_BACKEND=memory
SCENARIO_PERSISTENCE_BACKEND=memory
SCENARIO_HISTORY_LIMIT=100
POSTGRES_DB=citymind
POSTGRES_USER=citymind
POSTGRES_PASSWORD=citymind

AUTH_TOKEN_SECRET=citymind-local-development-secret-change-before-production
AUTH_TOKEN_TTL_SECONDS=3600
LOGIN_MAX_ATTEMPTS=5
LOGIN_IP_MAX_ATTEMPTS=30
LOGIN_WINDOW_SECONDS=60
LOGIN_RATE_LIMIT_MAX_KEYS=10000
RATE_LIMIT_BACKEND=memory
REGISTER_MAX_ATTEMPTS=5
REPORT_CREATE_MAX_ATTEMPTS=20
ASSISTANT_QUERY_MAX_ATTEMPTS=30
PUBLIC_QUERY_WINDOW_SECONDS=60
DOCS_ENABLED=true
CORS_ORIGINS=["http://127.0.0.1:3100","http://localhost:3000"]
TRUSTED_HOSTS=["127.0.0.1","localhost","testserver"]

AI_PROVIDER=local_rag
# Leave empty until the hosted AI integration is explicitly enabled.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
OPENAI_REASONING_EFFORT=low
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_OUTPUT_TOKENS=700
AI_ALLOW_LOCAL_FALLBACK=true
RAG_TOP_K=4
RAG_MIN_SCORE=0.34

REDIS_URL=redis://localhost:6379/0
MINIO_ROOT_USER=citymind
MINIO_ROOT_PASSWORD=citymind-local-password
STORAGE_PROVIDER=local
