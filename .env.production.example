APP_ENV=production
LOG_LEVEL=INFO
API_PORT=8100
WEB_PORT=3100

POSTGRES_DB=citymind
POSTGRES_USER=citymind
POSTGRES_PASSWORD=
DATABASE_URL=
DATABASE_READINESS_REQUIRED=true
OPERATIONAL_PERSISTENCE_BACKEND=database
SCENARIO_PERSISTENCE_BACKEND=database
SCENARIO_HISTORY_LIMIT=250

AUTH_TOKEN_SECRET=
AUTH_TOKEN_TTL_SECONDS=3600
LOGIN_MAX_ATTEMPTS=5
LOGIN_IP_MAX_ATTEMPTS=30
RATE_LIMIT_BACKEND=database
REGISTER_MAX_ATTEMPTS=5
REPORT_CREATE_MAX_ATTEMPTS=20
ASSISTANT_QUERY_MAX_ATTEMPTS=30
PUBLIC_QUERY_WINDOW_SECONDS=60
DOCS_ENABLED=false
CORS_ORIGINS=["https://citymind.example"]
TRUSTED_HOSTS=["api.citymind.example"]
PUBLIC_API_URL=https://api.citymind.example

AI_PROVIDER=local_rag
# Add this only when AI_PROVIDER=openai. Keep it server-side; never expose it to Next.js.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
OPENAI_REASONING_EFFORT=low
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_OUTPUT_TOKENS=700
AI_ALLOW_LOCAL_FALLBACK=true
RAG_TOP_K=4
RAG_MIN_SCORE=0.34
