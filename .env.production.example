# Production template. Copy to .env.production on the server, fill every blank, and
# keep the file out of version control (chmod 600).
#   docker compose --env-file .env.production -f infra/docker-compose.prod.yml up --build -d
APP_ENV=production
LOG_LEVEL=INFO

# Public hostnames. Caddy obtains TLS certificates for both automatically; point
# their DNS A/AAAA records at the server before starting the stack.
WEB_DOMAIN=citymind.example
API_DOMAIN=api.citymind.example
ACME_EMAIL=ops@citymind.example
PUBLIC_API_URL=https://api.citymind.example
# The web app's own address; links in account emails point here.
PUBLIC_WEB_URL=https://citymind.example

# --- Privacy notice (Law 81/2018) -------------------------------------------------
# Shown on /privacy: who is responsible for the data and where residents send
# access, correction and deletion requests. Have the notice reviewed by counsel.
DATA_CONTROLLER_NAME=
PRIVACY_CONTACT_EMAIL=

# --- Account email (verification + password reset) --------------------------------
# Any SMTP relay: Amazon SES (email-smtp.<region>.amazonaws.com), SendGrid
# (smtp.sendgrid.net, user "apikey"), Brevo (smtp-relay.brevo.com), Mailgun,
# Postmark. Verify the sending domain (SPF + DKIM) with the provider first.
EMAIL_FROM=no-reply@citymind.example
EMAIL_FROM_NAME=CityMind Tripoli
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_VERIFICATION_REQUIRED=true

# --- Monitoring ---------------------------------------------------------------------
# Optional Sentry DSN for API and web crash reports (bodies, cookies and auth
# headers are stripped before sending). Uptime checks: see docs/PRODUCTION_READINESS.md.
SENTRY_DSN=
CORS_ORIGINS=["https://citymind.example"]
TRUSTED_HOSTS=["api.citymind.example"]

# Database. URL-encode special characters in the password inside DATABASE_URL.
POSTGRES_DB=citymind
POSTGRES_USER=citymind
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+psycopg://citymind:<url-encoded-password>@db:5432/citymind
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
SCENARIO_HISTORY_LIMIT=250

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_TOKEN_SECRET=
AUTH_TOKEN_TTL_SECONDS=3600
# Hard limit on a sliding session; staff sign in again after this (12 hours).
AUTH_SESSION_MAX_AGE_SECONDS=43200
AUTH_COOKIE_SAME_SITE=lax

# The first owner account. Required: demo accounts are never created in production.
# Use a unique passphrase of 10+ characters mixing letters, digits and symbols, then
# create named accounts for staff from the admin page and rotate this one.
BOOTSTRAP_OWNER_EMAIL=
BOOTSTRAP_OWNER_PASSWORD=

API_WORKERS=2

# AI assistant provider: local_rag (no key) | gemini | openai
AI_PROVIDER=local_rag
AI_ALLOW_LOCAL_FALLBACK=true
# Required when AI_PROVIDER=gemini. Server-side only: never expose it to Next.js.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Ceiling on hosted-model calls per UTC day per API worker; after it the assistant
# answers from local evidence. Stored questions are redacted and kept this long.
AI_HOSTED_DAILY_REQUEST_LIMIT=2000
AI_QUERY_RETENTION_DAYS=180
# Required when AI_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
